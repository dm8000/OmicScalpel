# Live data: the hub spreadsheets are the app's mutable database, edited through the
# interface itself. Versioning them turns every edit into a multi-MB binary diff.
*.xlsx
!data-sample/**/*.xlsx

# Machine-local configuration. Copy config/config.txt.example and edit.
config/config.txt

# Generated from config/config.txt by tools/sync-renviron.R — never edit by hand.
.Renviron

# API keys. Never versioned: this repository is public, and a key in the working
# tree is one `git add -A` away from being in it. Copy apikeys.txt.example.
apikeys.txt
*.key

# R session leftovers
.Rhistory
.RData
.Rproj.user/
*.Rproj

# App output and agent scratch
**/outputs/
.subagente/

# Local run artifacts (backups/logs when config.txt points here)
.local/
Rplots.pdf
